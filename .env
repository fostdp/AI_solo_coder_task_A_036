# Wind Turbine Blade Monitor Environment Variables
# Copy this file to .env and fill in the appropriate values

# ============================================
# Server Configuration
# ============================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
CHANNEL_BUFFER_SIZE=1000

# ============================================
# Logging Configuration
# ============================================
RUST_LOG=info,wind_turbine_blade_monitor=debug
LOG_FORMAT=pretty
RUST_BACKTRACE=1

# ============================================
# InfluxDB Configuration
# ============================================
INFLUXDB_HOST=localhost
INFLUXDB_PORT=8086
INFLUXDB_DATABASE=wind_monitor
INFLUXDB_USER=wind_user
INFLUXDB_PASSWORD=wind_pass123
INFLUXDB_USE_SSL=false
INFLUXDB_BATCH_SIZE=500
INFLUXDB_BATCH_TIMEOUT_MS=100
INFLUXDB_CONNECTION_POOL_SIZE=8

# ============================================
# MES Configuration
# ============================================
MES_API_URL=http://mes.example.com/api/alerts
MES_API_TOKEN=your_mes_token_here
MES_ENABLED=false

# ============================================
# Configuration File Path
# ============================================
CONFIG_PATH=config/model_config.toml

# ============================================
# Simulator Configuration (optional)
# ============================================
API_URL=http://localhost:8000/api/v1/sensor
TURBINE_COUNT=100
BLADES_PER_TURBINE=3
STRAIN_SENSORS_PER_BLADE=20
AE_SENSORS_PER_BLADE=10
REPORT_INTERVAL=600
DAMAGE_PROBABILITY=0.15
DAMAGE_INJECTION_ENABLED=false
DAMAGE_INJECTION_INTERVAL=300
INJECTED_DAMAGE_TYPE=delamination
INJECTED_TURBINE_ID=WT050
